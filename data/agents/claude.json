{
  "id": "claude",
  "name": "Claude Code",
  "source": "screen",
  "launch": {
    "binary": "claude",
    "candidates": ["$PATH", "~/.local/bin/claude", "~/.claude/local/claude"],
    "args": ["--ax-screen-reader"],
    "session_args": ["--session-id", "{session}"],
    "resume_args": ["--resume", "{session}"],
    "model_args": ["--model", "{model}"],
    "effort_args": ["--effort", "{effort}"],
    "effort_values": ["low", "medium", "high", "xhigh", "max"],
    "unset_env": ["CLAUDE*"],
    "version_args": ["--version"],
    "permissions": {
      "names": ["Agent", "Bash", "Edit", "Glob", "Grep", "NotebookEdit", "Read", "Skill", "TodoWrite", "WebFetch", "WebSearch", "Write"],
      "patterns": ["^[A-Z][A-Za-z]*(.+)$", "^mcp__[A-Za-z0-9_-]+$"],
      "shape": "by_action",
      "path": ["permissions"],
      "arg": "--settings"
    },
    "exit": [
      { "clear_input": ["escape", "escape"] },
      { "command": "/exit" },
      { "sleep_ms": 800 },
      { "key": "enter" }
    ]
  },
  "screen": {
    "input_prefix": "$",
    "ready_settle_ms": 800,
    "busy_title": ["◐", "◑", "◒", "◓"],
    "turn_end": "osc133",
    "footer": { "pattern": "^\\S+ for [0-9][0-9hms ]* · done|^\\S+ for [0-9][0-9hms ]*$" },
    "settle_ms": 1500,
    "records": [
      { "kind": "user", "prefix": "you: ", "then": "notice", "then_when": "/" },
      { "kind": "assistant", "prefix": "claude: " },
      { "kind": "tool", "prefix": "tool: " },
      { "kind": "tool", "pattern": "^tool error: " },
      { "kind": "tool", "pattern": "^Read [0-9]+ .*ctrl\\+o to expand|^Listed [0-9]+ .*ctrl\\+o to expand|^Searched for [0-9]+ .*ctrl\\+o to expand|^Ran [0-9]+ .*ctrl\\+o to expand|^Found [0-9]+ .*ctrl\\+o to expand|^Fetched [0-9]+ .*ctrl\\+o to expand" },
      { "kind": "notice", "pattern": "^Interrupted .*What should Claude do instead" },
      { "kind": "notice", "pattern": "^ *Agent \".*\" finished" },
      { "kind": "notice", "pattern": "^ *Background command \".*\" " },
      { "kind": "notice", "pattern": "^Compacted (" },
      { "kind": "notice", "pattern": "^Conversation compacted" }
    ],
    "chrome": [
      { "pattern": "^[A-Z]\\S*…$" },
      { "pattern": "^[A-Z]\\S* \\S+…$" },
      { "prefix": "Tip: " },
      { "pattern": "^[0-9]+ tasks? (" },
      { "prefix": "✔ " },
      { "prefix": "◻ " },
      { "prefix": "◼ " },
      { "prefix": "☒ " },
      { "prefix": "☐ " },
      { "prefix": "Backgrounded agent (" },
      { "pattern": "^ *● " },
      { "pattern": "^ *◯ " },
      { "prefix": "manual mode on" },
      { "prefix": "auto mode on" },
      { "prefix": "accept edits on" },
      { "prefix": "plan mode on" },
      { "prefix": "bypass permissions on" },
      { "prefix": "⏵" },
      { "prefix": "⏸" },
      { "pattern": "^\\$$" },
      { "prefix": "$ " },
      { "prefix": "ctrl+g to edit" },
      { "pattern": "^/[a-z][-a-z0-9:_]*  +\\S" },
      { "pattern": "^                                        +\\S" },
      { "prefix": "[Screen Reader Mode: " },
      { "pattern": "^Claude Code v[0-9]" }
    ],
    "subagent": { "pattern": "^Waiting for [0-9]+ background agents? to finish" },
    "background": { "pattern": "· +[0-9]+ shell|· +[0-9]+ monitor" },
    "background_agent": { "pattern": "^ +◯ " },
    "choice_prompt": { "pattern": "^Select with numbers \\[|^Enter y/n:" },
    "selected_marker": "(selected)",
    "permission": { "prefix": "Permission Required:" },
    "bell_needs_input": true,
    "queued": { "prefix": "ctrl+enter to send now" },
    "text_options": [
      { "kind": "permission", "pattern": "^No$" }
    ],
    "resume_refused": { "prefix": "No conversation found with session ID: " },
    "paste": { "lead_in": "Please carry out the instructions in this text: ", "over_chars": 800, "pause_ms": 300 }
  },
  "actions": {
    "submit": [
      { "clear_input": ["escape", "escape"] },
      { "text": "{text}" },
      { "sleep_ms": 800 },
      { "key": "enter" }
    ],
    "queue": [
      { "text": "{text}" },
      { "sleep_ms": 800 },
      { "key": "enter" }
    ],
    "answer": [
      { "pick": "{choice}" },
      { "sleep_ms": 300 },
      { "key": "enter" },
      { "wait": "answered" }
    ],
    "answer_text": [
      { "pick": "{choice}" },
      { "sleep_ms": 300 },
      { "key": "enter" },
      { "wait": "answered" },
      { "wait": "idle" },
      { "clear_input": ["escape", "escape"] },
      { "text": "{text}" },
      { "sleep_ms": 800 },
      { "key": "enter" }
    ],
    "interrupt": [
      { "key": "escape" }
    ],
    "set_model": [
      { "command": "/model" },
      { "sleep_ms": 800 },
      { "key": "enter" },
      { "wait": "choice" },
      { "pick": "{model}" },
      { "sleep_ms": 300 },
      { "key": "s" },
      { "confirm": { "pattern": "^Set model to .* this session only" } }
    ],
    "set_effort": [
      { "relaunch": {} }
    ]
  },
  "errors": [
    { "class": "limit", "pattern": "You've hit your |Usage limit reached|usage limit reached|You're out of usage credits|Credit balance is too low|spend limit reached", "reset_marker": "resets " },
    { "class": "auth", "pattern": "Please run /login|Not logged in|Invalid API key|Invalid auth token|Authentication required|Failed to authenticate|OAuth token has expired" },
    { "class": "retrying", "pattern": "Retrying in [0-9]" },
    { "class": "overloaded", "pattern": "Repeated 529 Overloaded errors|is experiencing high load|^API Error[: (]+5[0-9][0-9]|overloaded_error" },
    { "class": "api", "pattern": "^API Error|^Prompt is too long" }
  ],
  "retry": { "prompt": "continue" },
  "facts": {
    "status_command": {
      "settings_path": ["statusLine"],
      "command_key": "command",
      "fields": { "type": "command" },
      "user_settings": [
        { "path": "{cwd}/.claude/settings.local.json" },
        { "path": "{cwd}/.claude/settings.json" },
        { "path": "~/.claude/settings.json", "dir_env": "CLAUDE_CONFIG_DIR" }
      ]
    },
    "map": {
      "context_used_percent": "context_window.used_percentage",
      "context_window_tokens": "context_window.context_window_size",
      "context_used_tokens": ["context_window.current_usage.input_tokens", "context_window.current_usage.cache_creation_input_tokens", "context_window.current_usage.cache_read_input_tokens"],
      "rate_5h_used_percent": "rate_limits.five_hour.used_percentage",
      "rate_5h_resets_at": "rate_limits.five_hour.resets_at",
      "rate_7d_used_percent": "rate_limits.seven_day.used_percentage",
      "rate_7d_resets_at": "rate_limits.seven_day.resets_at",
      "cost_usd": "cost.total_cost_usd"
    }
  }
}
