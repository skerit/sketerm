[Desktop Entry]
Type=Application
Name=Sketerm Web
GenericName=Web Browser
Comment=Web pages in sketerm tabs, rendered by an embedded Chromium engine
TryExec=sketerm-web
Exec=sketerm-web %U
Icon=dev.sker.sketerm.web
Categories=Network;WebBrowser;
MimeType=x-scheme-handler/http;x-scheme-handler/https;text/html;application/xhtml+xml;
StartupNotify=true
StartupWMClass=dev.sker.sketerm.web
Terminal=false
Keywords=web;browser;internet;www;http;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=sketerm-web
