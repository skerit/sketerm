# Maintainer: Jelle De Loecker <jelle@elevenways.be>
#
# Builds sketerm from the parent directory of this PKGBUILD (i.e. the
# checked-out repo). Run as:
#
#     cd dist && ./install.sh              # or: makepkg -sif
#     cd dist && ./install.sh --no-install # or: makepkg -sf
#
# The -f matters: pkgver() below derives the version from HEAD, so
# rebuilding the same commit produces a package file that already
# exists, and makepkg then refuses with "A package has already been
# built" and exits WITHOUT installing -- leaving the previously
# installed binary in place. Uncommitted source changes do not move
# pkgver either, so -f is the normal case, not the exception.
#
# makepkg rewrites the pkgver= line below on every run; the resulting
# dirty PKGBUILD in git status is expected, not a local edit.
#
# No check(): installing is not the time to run the suite. Run it
# yourself with `zig build test` from the checkout.
#
# A future AUR-submitted PKGBUILD will use a public git+ source instead.

pkgname=sketerm-git
_pkgname=sketerm
pkgver=0.0.0
pkgrel=1
pkgdesc='Native GTK4 terminal emulator written in Zig'
arch=('x86_64')
url='https://github.com/skerit/sketerm'
license=('GPL-3.0-or-later')
depends=(
    'gtk4>=4.14'
    'libadwaita>=1.4'
    'glib2>=2.74'
    'freetype2'
    'harfbuzz'
    'libepoxy'
    'fribidi'
    'fontconfig'
    'libvpx'  # VP9/WebM app-window recording (GUI only)
    'libpulse' # remote-audio playback (GUI links libpulse + glib mainloop)
    'opus'     # runtime-loaded remote-audio compression
    'glycin'   # sandboxed runtime-loaded image decoding for Viewer
    'libheif'  # Glycin AVIF/HEIF loader runtime
    # Browser engine for `sketerm web` / web panes. The DISTRO package
    # is used deliberately rather than the pinned upstream tarball the
    # dev flow downloads (`zig build fetch-cef`): it keeps ~300MB of
    # Chromium out of this package, it gets security updates from the
    # distro, and — measured, not assumed — it is built WITH proprietary
    # codecs, so H.264/AAC and Widevine work where the stock upstream
    # binaries have neither.
    'cef'
)
optdepends=(
    'xorg-xwayland: X11 application support in external displays'
    'xwayland-satellite>=0.8.1: rootless X window management in external displays'
)
makedepends=(
    'zig'
    'ncurses'  # provides tic, the terminfo compiler
)
provides=("$_pkgname")
conflicts=("$_pkgname")
source=()
sha256sums=()

source "$startdir/stage.sh"

# $startdir is dist/; the actual repo root is one level up.
_srcroot() { echo "$startdir/.."; }

pkgver() {
    cd "$(_srcroot)"
    local ver
    ver=$(grep -m1 '\.version' build.zig.zon | sed -E 's/.*"([^"]+)".*/\1/')
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        printf '%s.r%s.g%s' \
            "$ver" \
            "$(git rev-list --count HEAD)" \
            "$(git rev-parse --short=7 HEAD)"
    else
        printf '%s' "$ver"
    fi
}

build() {
    cd "$(_srcroot)"
    # Normal builds runtime-load Opus automatically. The portable daemon
    # compiles the probe out and stays static/codec-free by design.
    zig build -Doptimize=ReleaseFast
    zig build mux-portable -Doptimize=ReleaseFast
    # Browser helper, built against the DISTRO cef (see depends): the
    # headers and the runtime live in two places there, unlike the
    # single-tree upstream tarball, so both halves are pointed at
    # explicitly. -Dcef-runtime-dir defaults to -Dcef-lib, which is
    # already the installed location, so the rpath and the LD_PRELOAD
    # the helper re-execs with are both correct in the package.
    zig build web -Doptimize=ReleaseFast \
        -Dcef-include=/usr/include/cef \
        -Dcef-lib=/usr/lib/cef
}

package() {
    sketerm_stage "$(_srcroot)" "$pkgdir" gui 1 tic "$pkgname"
}

# vim:set ts=4 sw=4 et:
