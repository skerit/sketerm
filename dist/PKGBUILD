# Maintainer: Jelle De Loecker <jelle@elevenways.be>
#
# Builds sketerm from the parent directory of this PKGBUILD (i.e. the
# checked-out repo). Run as:
#
#     cd dist && ./install.sh          # or: makepkg -sif
#
# The -f matters: pkgver() below derives the version from HEAD, so
# rebuilding the same commit produces a package file that already
# exists, and makepkg then refuses with "A package has already been
# built" and exits WITHOUT installing -- leaving the previously
# installed binary in place. Uncommitted source changes do not move
# pkgver either, so -f is the normal case, not the exception.
#
# makepkg rewrites the pkgver= line below on every run; the resulting
# dirty PKGBUILD in git status is expected, not a local edit.
#
# No check(): installing is not the time to run the suite. Run it
# yourself with `zig build test` from the checkout.
#
# A future AUR-submitted PKGBUILD will use a public git+ source instead.

pkgname=sketerm-git
_pkgname=sketerm
pkgver=0.0.0
pkgrel=1
pkgdesc='Native GTK4 terminal emulator written in Zig'
arch=('x86_64')
url='https://github.com/skerit/sketerm'
license=('GPL-3.0-or-later')
depends=(
    'gtk4'
    'libadwaita'
    'freetype2'
    'harfbuzz'
    'libepoxy'
    'fribidi'
    'fontconfig'
    'libvpx'  # VP9/WebM app-window recording (GUI only)
    'libpulse' # remote-audio playback (GUI links libpulse + glib mainloop)
    'opus'     # runtime-loaded remote-audio compression
    'glycin'   # sandboxed runtime-loaded image decoding for Viewer
    'libheif'  # Glycin AVIF/HEIF loader runtime
    # Browser engine for `sketerm web` / web panes. The DISTRO package
    # is used deliberately rather than the pinned upstream tarball the
    # dev flow downloads (`zig build fetch-cef`): it keeps ~300MB of
    # Chromium out of this package, it gets security updates from the
    # distro, and — measured, not assumed — it is built WITH proprietary
    # codecs, so H.264/AAC and Widevine work where the stock upstream
    # binaries have neither.
    'cef'
)
optdepends=(
    'xorg-xwayland: X11 application support in external displays'
    'xwayland-satellite>=0.8.1: rootless X window management in external displays'
)
makedepends=(
    'zig'
    'ncurses'  # provides tic, the terminfo compiler
)
provides=("$_pkgname")
conflicts=("$_pkgname")
source=()
sha256sums=()

# $startdir is dist/; the actual repo root is one level up.
_srcroot() { echo "$startdir/.."; }

pkgver() {
    cd "$(_srcroot)"
    local ver
    ver=$(grep -m1 '\.version' build.zig.zon | sed -E 's/.*"([^"]+)".*/\1/')
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        printf '%s.r%s.g%s' \
            "$ver" \
            "$(git rev-list --count HEAD)" \
            "$(git rev-parse --short=7 HEAD)"
    else
        printf '%s' "$ver"
    fi
}

build() {
    cd "$(_srcroot)"
    # Normal builds runtime-load Opus automatically. The portable daemon
    # compiles the probe out and stays static/codec-free by design.
    zig build -Doptimize=ReleaseFast
    zig build mux-portable -Doptimize=ReleaseFast
    # Browser helper, built against the DISTRO cef (see depends): the
    # headers and the runtime live in two places there, unlike the
    # single-tree upstream tarball, so both halves are pointed at
    # explicitly. -Dcef-runtime-dir defaults to -Dcef-lib, which is
    # already the installed location, so the rpath and the LD_PRELOAD
    # the helper re-execs with are both correct in the package.
    zig build web -Doptimize=ReleaseFast \
        -Dcef-include=/usr/include/cef \
        -Dcef-lib=/usr/lib/cef
}

package() {
    cd "$(_srcroot)"

    # Main binary. The file manager is the SAME executable under its
    # own name (argv[0] dispatch): a distinct binary + cmdline is what
    # keeps Plasma's taskbar from merging the two apps. Hardlinked so
    # the package does not ship the 5MB binary twice.
    install -Dm755 zig-out/bin/sketerm "$pkgdir/usr/bin/sketerm"
    ln "$pkgdir/usr/bin/sketerm" "$pkgdir/usr/bin/sketerm-files"
    ln "$pkgdir/usr/bin/sketerm" "$pkgdir/usr/bin/sketerm-viewer"
    ln "$pkgdir/usr/bin/sketerm" "$pkgdir/usr/bin/sketerm-editor"
    ln "$pkgdir/usr/bin/sketerm" "$pkgdir/usr/bin/sketerm-web"

    # Session daemon (durable panes; links libc only)
    install -Dm755 zig-out/bin/sketerm-mux "$pkgdir/usr/bin/sketerm-mux"

    # Browser engine helper. Deliberately NOT named `sketerm-web` —
    # that is the GUI's browser identity above. The GUI finds this one
    # as a sibling of its own executable.
    install -Dm755 zig-out/bin/sketerm-webengine "$pkgdir/usr/bin/sketerm-webengine"

    # Portable daemon for scp-to-server deployment: baseline CPU +
    # static musl, so it runs on older CPUs and any libc (the native
    # build above SIGILLs on pre-AVX-512 hosts). See docs/REMOTE.md.
    install -Dm755 zig-out/bin/sketerm-mux-portable \
        "$pkgdir/usr/lib/$_pkgname/sketerm-mux-portable"

    # Desktop entry + scalable icon (auto-discovered by the hicolor theme)
    install -Dm644 data/dev.sker.sketerm.desktop \
        "$pkgdir/usr/share/applications/dev.sker.sketerm.desktop"
    install -Dm644 data/dev.sker.sketerm.files.desktop \
        "$pkgdir/usr/share/applications/dev.sker.sketerm.files.desktop"
    install -Dm644 data/dev.sker.sketerm.viewer.desktop \
        "$pkgdir/usr/share/applications/dev.sker.sketerm.viewer.desktop"
    install -Dm644 data/dev.sker.sketerm.editor.desktop \
        "$pkgdir/usr/share/applications/dev.sker.sketerm.editor.desktop"
    install -Dm644 data/dev.sker.sketerm.web.desktop \
        "$pkgdir/usr/share/applications/dev.sker.sketerm.web.desktop"
    install -Dm644 data/icons/hicolor/scalable/apps/dev.sker.sketerm.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.sker.sketerm.svg"

    # Files mode is its own application identity (own GApplication id,
    # own taskbar entry), so it needs its own app icon.
    install -Dm644 data/icons/hicolor/scalable/apps/dev.sker.sketerm.files.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.sker.sketerm.files.svg"
    install -Dm644 data/icons/hicolor/scalable/apps/dev.sker.sketerm.viewer.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.sker.sketerm.viewer.svg"
    install -Dm644 data/icons/hicolor/scalable/apps/dev.sker.sketerm.editor.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.sker.sketerm.editor.svg"
    install -Dm644 data/icons/hicolor/scalable/apps/dev.sker.sketerm.web.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.sker.sketerm.web.svg"

    # Bundled symbolic action icons (split left/right + top/bottom for
    # the context menu; rendering for the prefs page; terminal for the
    # browser toolbar), found via the hicolor fallback theme so they
    # resolve regardless of icon theme.
    install -Dm644 data/icons/hicolor/scalable/actions/sketerm-terminal-symbolic.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/actions/sketerm-terminal-symbolic.svg"
    install -Dm644 data/icons/hicolor/scalable/actions/sketerm-split-left-right-symbolic.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/actions/sketerm-split-left-right-symbolic.svg"
    install -Dm644 data/icons/hicolor/scalable/actions/sketerm-split-top-bottom-symbolic.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/actions/sketerm-split-top-bottom-symbolic.svg"
    install -Dm644 data/icons/hicolor/scalable/actions/sketerm-rendering-symbolic.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/actions/sketerm-rendering-symbolic.svg"
    install -Dm644 data/icons/hicolor/scalable/actions/sketerm-preview-pane-symbolic.svg \
        "$pkgdir/usr/share/icons/hicolor/scalable/actions/sketerm-preview-pane-symbolic.svg"

    # xdg-desktop-portal FileChooser backend (OPT-IN: installing these
    # files only makes the backend selectable; nothing uses it until
    # the user names it in portals.conf -- see docs/portal.md).
    install -Dm644 data/sketerm.portal \
        "$pkgdir/usr/share/xdg-desktop-portal/portals/sketerm.portal"
    install -Dm644 data/org.freedesktop.impl.portal.desktop.sketerm.service \
        "$pkgdir/usr/share/dbus-1/services/org.freedesktop.impl.portal.desktop.sketerm.service"

    # License
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

    # Sample config + saved-layout reference (read-only)
    install -Dm644 data/sample.conf "$pkgdir/usr/share/$_pkgname/sample.conf"
    install -Dm644 data/sample.layout "$pkgdir/usr/share/$_pkgname/sample.layout"

    # Ready-made CRT shaders (custom_shader / "Pane Shader…").
    # Per-file licensing (all GPL-3-compatible) — see
    # data/shaders/README.
    install -Dm644 data/shaders/crt.glsl \
        "$pkgdir/usr/share/$_pkgname/shaders/crt.glsl"
    install -Dm644 data/shaders/crt-lottes.glsl \
        "$pkgdir/usr/share/$_pkgname/shaders/crt-lottes.glsl"
    install -Dm644 data/shaders/crt-easymode.glsl \
        "$pkgdir/usr/share/$_pkgname/shaders/crt-easymode.glsl"
    install -Dm644 data/shaders/zfast-crt.glsl \
        "$pkgdir/usr/share/$_pkgname/shaders/zfast-crt.glsl"
    install -Dm644 data/shaders/README \
        "$pkgdir/usr/share/$_pkgname/shaders/README"

    # Shell-integration scripts + auto-injection shims. zsh/fish are
    # injected automatically at spawn; bash users source sketerm.bash
    # from their rc file.
    install -Dm644 data/shell-integration/sketerm.bash \
        "$pkgdir/usr/share/$_pkgname/shell-integration/sketerm.bash"
    install -Dm644 data/shell-integration/sketerm.zsh \
        "$pkgdir/usr/share/$_pkgname/shell-integration/sketerm.zsh"
    install -Dm644 data/shell-integration/sketerm.fish \
        "$pkgdir/usr/share/$_pkgname/shell-integration/sketerm.fish"
    install -Dm644 data/shell-integration/zsh/.zshenv \
        "$pkgdir/usr/share/$_pkgname/shell-integration/zsh/.zshenv"
    install -Dm644 data/shell-integration/bash/sketerm-rc.bash \
        "$pkgdir/usr/share/$_pkgname/shell-integration/bash/sketerm-rc.bash"
    install -Dm644 data/shell-integration/fish-xdg/fish/vendor_conf.d/sketerm.fish \
        "$pkgdir/usr/share/$_pkgname/shell-integration/fish-xdg/fish/vendor_conf.d/sketerm.fish"

    # Compile + install the terminfo entry system-wide so $TERM=sketerm-256color
    # resolves without per-user setup.
    install -d "$pkgdir/usr/share/terminfo"
    tic -x -o "$pkgdir/usr/share/terminfo" terminfo/sketerm-256color.src
}

# vim:set ts=4 sw=4 et:
